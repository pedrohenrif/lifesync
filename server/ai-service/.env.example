PORT=4006
AI_MONGODB_URI=mongodb://localhost:27023/lifesync_ai
JWT_SECRET=lifesync_auth_sk_jwt

# Chave da OpenAI. Sem ela o serviço sobe, mas responde AI_DISABLED.
OPENAI_API_KEY=
# gpt-5-mini equilibra custo e confiabilidade em extração estruturada.
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Vazio desliga o parâmetro (modelos sem reasoning). Valores: minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
# Teto de gasto por usuário por mês, em dólares.
AI_MONTHLY_BUDGET_USD=2
OPENAI_TIMEOUT_MS=30000
