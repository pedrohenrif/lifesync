PORT=4007
CALENDAR_MONGODB_URI=mongodb://localhost:27024/lifesync_calendar
JWT_SECRET=lifesync_auth_sk_jwt

# Credenciais do cliente OAuth criado no Google Cloud (aba Clientes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Precisa bater exatamente com o URI de redirecionamento cadastrado no Google.
GOOGLE_REDIRECT_URI=https://lifesync.agrosync.cloud/api/calendar/oauth/callback

# Para onde o usuário volta depois de autorizar.
APP_URL=https://lifesync.agrosync.cloud

# Chave de 32 bytes em base64 para cifrar o refresh token: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Fuso usado ao criar eventos sem offset explícito.
CALENDAR_TIMEZONE=America/Sao_Paulo
