NODE_ENV=development
PORT=4000
# MongoDB dedicado ao auth-service (database-per-service)
AUTH_MONGODB_URI=mongodb://localhost:27017/lifesync_auth
# Chave compartilhada para assinatura JWT (use segredo forte em produção)
JWT_SECRET=change-me-in-production

# Gmail SMTP para o código de redefinição de senha.
# Crie uma senha de app em https://myaccount.google.com/apppasswords
# (precisa ter verificação em duas etapas ligada).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opcional. Sem isso, o remetente fica igual ao SMTP_USER.
SMTP_FROM=
